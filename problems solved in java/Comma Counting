class Solution {
    public int countCommas(int n) {
        int count=0;
    
        for(int i=1;i<=n;i++){
            int c=0;
            int temp=i;
            while(temp!=0){
                int rem=temp%10;
                c++;
                temp=temp/10;
                
            }
            count+=(c-1)/3;
        }
        return count;
        
    }
}
