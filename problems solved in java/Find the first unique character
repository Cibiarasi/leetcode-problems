class Solution {
    public int firstUniqChar(String s) {
        HashMap <Character,Integer> set=new HashMap<>();
        for(char ch: s.toCharArray()){
            set.put(ch,set.getOrDefault(ch,0)+1);
            
        }
        for(int i=0;i<s.length();i++){
            char ch=s.charAt(i);
            if(set.get(ch)==1){
                return i;
            }
        }
        return -1;
        
        
    }
}
