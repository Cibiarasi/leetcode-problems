class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {
        HashSet <Integer> set=new HashSet<>();
        for(int nums: nums1){
            set.add(nums);
        }
        HashSet <Integer> set2=new HashSet<>();
        for(int nums: nums2){
            if(set.contains(nums)){
                set2.add(nums);
            }
        }
        int arr[]=new int[set2.size()];
        int i=0;
        for(int val: set2){
            arr[i]=val;
            i++;

        }
        return arr;
    }
}
